# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# GOOGLE CLOUD STORAGE
GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"..."}

# GEMINI API
GEMINI_API_KEY=your-gemini-api-key

# STRIPE
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# REPLICATE (for AI image generation)
REPLICATE_API_TOKEN=r8_...

# COMFYDEPLOY (for stencil processing)
COMFY_DEPLOY_API_KEY=your-comfy-deploy-api-key

# SESSION
SESSION_SECRET=your-session-secret-at-least-32-chars

# ===================================
# FIREBASE AUTHENTICATION (NEW)
# ===================================

# Firebase Admin SDK (Backend) - Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Frontend) - Get from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456



# ===================================
# INSTRUCTIONS TO SET UP FIREBASE:
# ===================================
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Enable Authentication and configure providers:
#    - Email/Password
#    - Google
#    - Apple (requires Apple Developer account)
# 3. Get Admin SDK credentials:
#    - Go to Project Settings > Service Accounts
#    - Generate new private key
#    - Copy values to FIREBASE_* variables above
# 4. Get Client SDK config:
#    - Go to Project Settings > General
#    - Copy the firebaseConfig values to VITE_FIREBASE_* variables
# 5. Configure authorized domains:
#    - Go to Authentication > Settings
#    - Add your domain to authorized domains